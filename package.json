{
  "name": "carewell-medical-centre",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:api": "npm run dev -w @carewell/backend",
    "dev:web": "npm run dev -w @carewell/frontend",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:fresh": "node ./backend/scripts/dev-clean.mjs && npm run dev:all",
    "dev:clean": "node ./backend/scripts/dev-clean.mjs",
    "demo": "npm run build && npm run start",
    "smoke": "node ./backend/scripts/smoke-routes.mjs",
    "build": "npm run build -w @carewell/frontend",
    "build:api": "npm run build:server -w @carewell/backend",
    "start": "npm run start -w @carewell/frontend",
    "start:api": "npm run start -w @carewell/backend",
    "lint": "npm run lint -w @carewell/frontend",
    "postbuild": "npm run postbuild -w @carewell/frontend",
    "db:up": "docker compose -f db/docker-compose.yml up -d",
    "db:down": "docker compose -f db/docker-compose.yml down",
    "db:generate": "dotenv -e .env.local -- npm run db:generate -w @carewell/backend",
    "db:migrate": "dotenv -e .env.local -- npm run db:migrate -w @carewell/backend",
    "db:push": "dotenv -e .env.local -- npm run db:push -w @carewell/backend",
    "db:studio": "dotenv -e .env.local -- npm run db:studio -w @carewell/backend",
    "sanity:seed": "node ./backend/scripts/seed-sanity.mjs",
    "seo:audit": "node ./backend/scripts/seo-audit.mjs",
    "redirects:verify": "node ./backend/scripts/verify-redirects.mjs",
    "redirects:legacy": "node ./backend/scripts/sync-legacy-redirects.mjs",
    "redirects:prune-blog-map": "node ./backend/scripts/prune-blog-from-url-map.mjs",
    "redirects:fix-blogs": "node ./backend/scripts/fix-inverted-blog-redirects.mjs",
    "bundle:report": "node ./backend/scripts/bundle-report.mjs",
    "reviews:fetch": "node ./backend/scripts/fetch-google-reviews.mjs",
    "sanity:list-services": "node ./backend/scripts/list-services-for-import.mjs",
    "scrape:import": "node ./backend/scripts/import-scrape-pdfs.mjs",
    "scrape:import-blog": "node ./backend/scripts/import-scrape-blog.mjs",
    "cloudinary:check": "cd backend && npx tsx scripts/check-cloudinary.mjs",
    "images:migrate": "cd backend && npx tsx scripts/migrate-images-to-cloudinary.mjs",
    "images:fix-urls": "node ./backend/scripts/fix-cloudinary-double-urls.mjs",
    "images:apply-map": "node ./backend/scripts/apply-cloudinary-asset-map.mjs",
    "images:prune-local": "node ./backend/scripts/remove-migrated-local-images.mjs",
    "images:audit": "node ./backend/scripts/audit-cloudinary-images.mjs",
    "scrape:export": "cd backend && npx tsx scripts/batch-scrape-export.mjs",
    "scrape:export-blog": "cd backend && npx tsx scripts/batch-scrape-export-posts.mjs",
    "test:scraper": "npx tsx ./backend/scripts/test-scraper.mjs",
    "test:scraper:live": "npx tsx ./backend/scripts/test-scraper.mjs --live",
    "test:scraper:fixture": "npx tsx ./backend/scripts/test-scraper.mjs --fetch-fixture",
    "youtube:latest": "node ./backend/scripts/youtube-latest-example.mjs",
    "analyze": "npm run analyze -w @carewell/frontend",
    "cms:import-sanity": "node ./backend/scripts/migrate-sanity-to-prisma.mjs",
    "cms:import-redirects": "node ./backend/scripts/import-redirects-to-db.mjs",
    "cms:export-blog-seed": "node ./backend/scripts/export-blog-seed.mjs",
    "cms:import-blog-seed": "node ./backend/scripts/import-blog-seed.mjs",
    "cms:sync-legacy-sitemap": "dotenv -e .env.local -- node ./backend/scripts/sync-legacy-sitemap-pages.mjs",
    "cms:sync-legacy-sitemap-posts": "dotenv -e .env.local -- node ./backend/scripts/sync-legacy-sitemap-posts.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0"
  }
}
