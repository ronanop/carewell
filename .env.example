# Monorepo: keep this file at the repo root (or copy/symlink to frontend/.env.local).
SITE_URL=https://www.carewellmedicalcentre.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Standalone API server (@carewell/backend) — optional in production (Next runs /api/* in-process by default)
# Set API_URL only when the API is hosted on a separate origin (not localhost).
API_URL=
API_PORT=4000
# Used by the API to call Next on-demand revalidation after CMS saves
FRONTEND_URL=http://localhost:3000

# PostgreSQL (local: npm run db:up)
DATABASE_URL=postgresql://carewell:carewell@localhost:5433/carewell
# Render: runtime can use the **Internal** URL; `next build` cannot reach it (private network).
# Keep Internal for the web service, or use External (host *.render.com?sslmode=require) if you need DB at build time.
# SKIP_DATABASE_BUILD=1 forces skipping DB during `npm run build` (auto when Internal URL is detected).

# cms | sanity — read path (default: prisma)
CMS_PROVIDER=prisma

# One-time Sanity import only (npm run cms:import-sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# POST /api/revalidate after admin content saves
SANITY_REVALIDATE_SECRET=

# Optional: Google Maps embed iframe src
# NEXT_PUBLIC_CLINIC_MAP_EMBED_URL=https://www.google.com/maps/embed?pb=...

# Admin dashboard (/admin) — stateless signed cookie session (Render: set in Environment)
# ADMIN_SESSION_SECRET: random string, 16+ characters (e.g. openssl rand -base64 32)
ADMIN_SESSION_SECRET=
# Use ADMIN_PASSWORD for simple auth, or ADMIN_PASSWORD_HASH (bcrypt) for hashed passwords
ADMIN_PASSWORD=
# ADMIN_EMAIL=ops@example.com
# ADMIN_PASSWORD_HASH=

# Admin scraper default source (optional; must stay on allowlisted host)
# SCRAPER_BASE_URL=https://www.carewellmedicalcentre.com/

# Lead pipeline (optional — wire any combination)
GOOGLE_SHEETS_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TO_EMAIL=
LEAD_WHATSAPP_WEBHOOK_URL=

# Reviews snapshot (JSON string) — or implement Places API fetch in src/lib/reviews.ts
GOOGLE_PLACES_JSON=

# Skin scan (/skin-scan) — OpenAI vision (server only). Copy into .env.local; never commit real keys here.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: must be vision-capable for skin photos (default gpt-4o). Examples: gpt-4o, gpt-4o-mini — not gpt-3.5
OPENAI_SKIN_MODEL=
# Optional: custom API base (Azure OpenAI, proxy). Default https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# YouTube latest videos
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Analytics (also editable in Sanity siteSettings)
NEXT_PUBLIC_GTM_ID=

# Dev only: if CSS randomly breaks (common with OneDrive-synced folders), enable file polling:
# WATCHPACK_POLLING=true
